# Environment variables for the Gemma RunPod serverless worker.
# Copy to `.env` for local Docker runs, or set these on the RunPod endpoint.
# Names and DEFAULTS only — never commit real secrets (R1).

# --- Model selection -------------------------------------------------------
# Default model alias (catalog) baked at build time; also the response label.
DEFAULT_MODEL_NAME=gemma-4-e2b-it
# Override the GGUF filename to serve (otherwise: .active_model marker, then
# the model-defaults.sh default).
# MODEL_FILE=gemma-4-E2B-it-UD-Q6_K_XL.gguf
MODELS_DIR=/models

# --- llama-server flags (consumed by entrypoint.sh) ------------------------
N_CTX=40192
N_GPU_LAYERS=-1
N_BATCH=512
N_UBATCH=1024
FLASH_ATTN_MODE=on
# Optional MTP draft model for speculative decoding (only used if present in
# MODELS_DIR). Leave unset to disable.
# DRAFT_MODEL_FILE=gemma-4-E2B-it-assistant.Q8_0.gguf
# N_GPU_LAYERS_DRAFT=99
# Reasoning format is OFF by default for Gemma. Set to e.g. "deepseek" only if
# your model emits <think> tags natively.
# REASONING_FORMAT=none

# --- Handler: cold-start health gate ---------------------------------------
LLAMA_SERVER_URL=http://127.0.0.1:8080
LLAMA_HEALTH_TIMEOUT=300
LLAMA_HEALTH_INTERVAL=2
# Set to 1 to skip the health gate (used by the test suite only).
# SKIP_HEALTH_CHECK=0

# --- Handler: generation defaults & validation limits ----------------------
DEFAULT_SYSTEM_PROMPT=You are a highly knowledgeable, kind, and helpful assistant.
DEFAULT_MAX_TOKENS=4096
MAX_GENERATION_TOKENS=40192
MAX_MESSAGES=256
MAX_CONTENT_LENGTH=500000
MAX_STOP_SEQUENCES=16
